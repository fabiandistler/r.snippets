# targets package snippets

# ─────────────────────────────────────────────────────────────
# Setup & Configuration
snippet tarinit "Initialize targets project"
	targets::use_targets()

# ─────────────────────────────────────────────────────────────
# Target Definition
snippet tar "Basic target"
	targets::tar_target(
		name = ${1:target_name},
		command = ${2:expression}
	)

snippet tarfile "File target"
	targets::tar_target(
		name = ${1:file_target},
		command = ${2:"path/to/file.csv"},
		format = "file"
	)

# ─────────────────────────────────────────────────────────────
# Dynamic Branching
snippet tarmap "Map over single target"
	tar_target(
		name = ${1:mapped_target},
		command = ${2:expression_using_}${3:upstream},
		pattern = map(${3:upstream})
	)


# ─────────────────────────────────────────────────────────────
# Pipeline Execution
snippet tarmake "Run pipeline"
	targets::tar_make()

# ─────────────────────────────────────────────────────────────
# Reading Results
snippet tarread "Read single target"
	targets::tar_read(${1:target_name})

snippet tarload "Load targets into environment"
	targets::tar_load(${1:target_name})

# ─────────────────────────────────────────────────────────────
# Inspection & Visualization
snippet tarvis "Visualize pipeline network"
	targets::tar_visnetwork(
		names = ${1:NULL},
		outdated = ${2:TRUE},
		label = "${3:time}",
		level_separation = ${4:100}
	)

snippet tarman "Show manifest"
	targets::tar_manifest(
		names = ${1:NULL},
		fields = tidyselect::any_of(c("name", "command", "pattern", "description"))
	)

snippet tarout "Check outdated targets"
	targets::tar_outdated()

snippet tarprog "Show progress"
	targets::tar_progress()

# ─────────────────────────────────────────────────────────────
# Cleanup & Management
snippet tardelete "Delete specific targets"
	targets::tar_delete(names = c(${1:"target1", "target2"}))

snippet tardestroy "Remove entire store"
	targets::tar_destroy()

snippet tarprune "Remove outdated objects"
	targets::tar_prune()

snippet targc "Run garbage collection"
	targets::tar_invalidate(names = c(${1:"target_name"}))

# ─────────────────────────────────────────────────────────────
# Debugging & Development
snippet tarworkspace "Load target workspace for debugging"
	targets::tar_workspace(${1:target_name})

snippet tardebug "Set debug mode for target"
	targets::tar_option_set(debug = "${1:target_name}")

# ─────────────────────────────────────────────────────────────
# tarchetypes Integration
snippet targroup "Group by columns (tarchetypes)"
	tar_group_by(
		name = ${1:grouped_data},
		command = ${2:data},
		${3:grouping_column}
	)

snippet tarmap2 "Map with custom names (tarchetypes)"
	tar_map(
		values = tibble::tibble(
			${1:param1} = ${2:c("a", "b", "c")},
			${3:param2} = ${4:c(1, 2, 3)}
		),
		targets::tar_target(
			name = ${5:target_name},
			command = ${6:expression_using_params}
		)
	)

snippet tarrender "Render Rmd document (tarchetypes)"
	tar_render(
		name = ${1:report},
		path = "${2:report.Rmd}",
		params = list(${3})
	)

snippet tarquarto "Render Quarto document (tarchetypes)"
	tar_quarto(
		name = ${1:report},
		path = "${2:report.qmd}",
		execute_params = list(${3})
	)

# ─────────────────────────────────────────────────────────────
# Common Patterns
snippet tardata "Data loading pattern"
	targets::tar_target(
		name = ${1:raw_data},
		command = ${2:data.table::fread}(${3:file_path}),
		format = "${4:qs}"
	)

snippet tarmodel "Model fitting pattern"
	targets::tar_target(
		name = ${1:model},
		command = {
			${2:lm}(${3:formula}, data = ${4:prepared_data})
		}
	)

snippet tarplot "Plot creation pattern"
	targets::tar_target(
		name = ${1:plot},
		command = {
			ggplot2::ggplot(${2:data}, ggplot2::aes(${3})) +
				${4:geom_point}()
		}
	)

snippet tarsave "Save output pattern"
	targets::tar_target(
		name = ${1:output_file},
		command = {
			${2:ggsave}("${3:output.png}", ${4:plot_object})
			"${3:output.png}"
		},
		format = "file"
	)

# ─────────────────────────────────────────────────────────────
# Metadata & Information
snippet tarmeta "Get target metadata"
	targets::tar_meta(names = ${1:NULL}, fields = ${2:NULL})

snippet tarage "Get target timestamp/age"
	targets::tar_meta(names = ${1:target_name}, fields = c("time", "seconds"))

snippet tarnetwork "Network data for visualization"
	targets::tar_network(names = ${1:NULL}, outdated = ${2:TRUE})

snippet tarsiblings "Get target siblings"
	targets::tar_sibling(${1:target_name})

snippet tardeps "Show target dependencies"
	targets::tar_deps(${1:target_name})

snippet tarbranches "List dynamic branches"
	targets::tar_branches(${1:target_name})

# ─────────────────────────────────────────────────────────────
# Timestamps and Caching
snippet tarts "Get target timestamp"
	targets::tar_timestamp(${1:target_name})

snippet tarolder "Check if target older than"
	targets::tar_older(${1:target_name}, ${2:time})

snippet tarnewer "Check if target newer than"
	targets::tar_newer(${1:target_name}, ${2:time})

snippet tarcue "Show target cue (why outdated)"
	targets::tar_cue(mode = "${1:thorough}", command = ${2:TRUE}, depend = ${3:TRUE})

# ─────────────────────────────────────────────────────────────
# Repository Management
snippet tarpath "Get targets store path"
	targets::tar_path_store()

snippet tarexist "Check if target exists"
	targets::tar_exist_objects(names = c(${1:"target_name"}))

snippet tarpathtarget "Get path to target object"
	targets::tar_path_target(${1:target_name})

snippet tarconfig "Get targets configuration"
	targets::tar_config_get("${1:store}")

snippet tarscript "Get path to _targets.R"
	targets::tar_config_get("script")

# ─────────────────────────────────────────────────────────────
# Parallel & Performance
snippet taroptions "Set target options"
	targets::tar_option_set(
		packages = c(${1:"dplyr", "data.table"}),
		format = "${2:qs}",
		memory = "${3:transient}",
		garbage_collection = ${4:TRUE},
		deployment = "${5:main}",
		priority = ${6:0}
	)

snippet tarresources "Set computing resources"
	targets::tar_resources(
		${1:qs} = targets::tar_resources_${1:qs}(preset = "${2:high}")
	)

snippet tarformat "Common storage formats"
	format = "${1:qs|rds|fst|fst_dt|fst_tbl|keras|torch|file}"

snippet tarmemory "Memory settings"
	memory = "${1:persistent|transient}"

snippet tardeploy "Deployment settings"
	deployment = "${1:main|worker}"

# ─────────────────────────────────────────────────────────────
# Error Handling
snippet tarerror "Set error mode"
	targets::tar_option_set(error = "${1:stop}")

snippet tarworkload "Show workload summary"
	targets::tar_workload()

snippet tarnames "List all target names"
	targets::tar_names()

snippet tarcompletednames "List completed targets"
	targets::tar_completed(names = ${1:NULL})

snippet tarcanceled "List canceled targets"
	targets::tar_canceled(names = ${1:NULL})

snippet tarerrored "List errored targets"
	targets::tar_errored(names = ${1:NULL})

# ─────────────────────────────────────────────────────────────
# Advanced Patterns
snippet tarpattern "Create pattern with crossmap"
	targets::tar_target(
		name = ${1:results},
		command = ${2:analyze}(${3:data}, ${4:param}),
		pattern = cross(${3:data}, ${4:param})
	)

snippet tarhead "Get first elements of branches"
	targets::tar_target(
		name = ${1:sample},
		command = head(${2:data}, ${3:100}),
		pattern = head(${2:data}, n = ${4:5})
	)

snippet tartail "Get last elements of branches"
	targets::tar_target(
		name = ${1:sample},
		command = tail(${2:data}, ${3:100}),
		pattern = tail(${2:data}, n = ${4:5})
	)

snippet tarsample "Sample branches"
	targets::tar_target(
		name = ${1:sample},
		command = ${2:data},
		pattern = sample(${2:data}, size = ${3:10})
	)

# ─────────────────────────────────────────────────────────────
# Reporting
snippet tarreport "Generate target report"
	targets::tar_report(fields = ${1:NULL}, path_store = targets::tar_path_store())

snippet tarwatch "Watch pipeline in browser"
	targets::tar_watch(
		seconds = ${1:10},
		outdated = ${2:TRUE},
		targets_only = ${3:TRUE}
	)

snippet targlimpse "Quick pipeline overview"
	targets::tar_glimpse()

# ─────────────────────────────────────────────────────────────
# Testing & Validation
snippet tarvalidate "Validate _targets.R"
	targets::tar_validate()

snippet tartest "Test target interactively"
	targets::tar_make(names = ${1:target_name}, callr_function = NULL)

# ─────────────────────────────────────────────────────────────
# Branching Helpers (tarchetypes)
snippet tarrepbatch "Replicate with batching"
	tarchetypes::tar_rep(
		name = ${1:sim},
		command = ${2:simulate()},
		batches = ${3:10},
		reps = ${4:100}
	)

snippet tarfiles "Track multiple input files"
	tarchetypes::tar_files(
		name = ${1:input_files},
		command = list.files("${2:data}", full.names = TRUE)
	)

snippet tarformat2 "Multiple formats for same target"
	tarchetypes::tar_format_feather(
		name = ${1:data},
		command = ${2:read_data()}
	)
